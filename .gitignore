docker-compose.override.yml

# ---- Agent tooling ----
.remember/
# CodeGraph index: a local database plus daemon scratch, per machine. It carries
# its own self-ignoring .gitignore, but naming it here keeps the whole directory
# out regardless of how the tool evolves.
.codegraph/
# Symlinks into .venv, recreated by 'uvx library-skills' after 'uv sync'.
# .claude/skills/fastapi is a symlink to .agents/skills/fastapi, so both
# must be ignored together or a fresh clone gets a dangling link.
.agents/skills/fastapi
.claude/skills/fastapi

